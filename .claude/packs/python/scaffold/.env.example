# Copy this file to .env and fill it in. The .env is NEVER committed
# (make sure it is in .gitignore). FastAPI does not read .env by itself:
# config.py with pydantic-settings is what loads it (create it at the first
# real env var — see PACK.md and SCAFFOLD.md).

# API port in development (`fastapi dev` uses 8000 by default;
# change it with `--port` or record it here for the future config.py).
PORT=8000

# Database connection string — placeholder, replace user/password/host/db.
DATABASE_URL=postgresql://user:password@localhost:5432/database_name
