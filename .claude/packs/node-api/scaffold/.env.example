# Copy this file to .env and fill it in. The .env is NEVER committed
# (it is in .gitignore); a secret that was ever committed is compromised —
# rotate it, removing it is not enough (PACK.md).

# The API's HTTP port. Read in src/server.ts; defaults to 3000 if absent.
PORT=3000

# Database connection string — placeholder, replace user/password/host/db.
# It only becomes required when the project connects to a real database.
DATABASE_URL=postgresql://user:password@localhost:5432/database_name
